# =============================================================================
# NetMon Environment Configuration
# Copy this file to .env and update values for your environment
# =============================================================================

# Database
DATABASE_URL=postgresql://netmon:CHANGE_ME@db:5432/netmon
POSTGRES_PASSWORD=CHANGE_ME
TIMESCALEDB_ENABLED=true

# Redis
REDIS_URL=redis://redis:6379/0

# Security — REQUIRED: generate a random key, e.g. `openssl rand -base64 48`
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment (development | production)
ENVIRONMENT=development

# LDAP (optional — set LDAP_ENABLED=true to activate)
LDAP_ENABLED=false
# LDAP_SERVER=ldap://ldap.example.com
# LDAP_PORT=389
# LDAP_USE_SSL=false
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_BIND_DN=cn=readonly,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_FILTER=(sAMAccountName={username})
# LDAP_ADMIN_GROUP=CN=NetMon Admins,OU=Groups,DC=example,DC=com
# LDAP_OPERATOR_GROUP=CN=NetMon Operators,OU=Groups,DC=example,DC=com

# SMTP Email Settings (optional — required for email notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=monitoring@yourcompany.com
# SMTP_USE_TLS=true

# Monitoring Intervals (seconds)
PING_INTERVAL=60
SNMP_POLL_INTERVAL=300
HTTP_CHECK_INTERVAL=120
NTP_POLL_INTERVAL=60

# Alert Thresholds (missed pings before alerting)
MISSED_PINGS_WARNING=2
MISSED_PINGS_CRITICAL=3

# Syslog / SNMP Trap Listener Ports
SYSLOG_PORT=514
SNMP_TRAP_PORT=162

# DNS Servers (comma-separated, for reverse lookups)
# DNS_SERVERS=8.8.8.8,8.8.4.4

# DHCP Sync (optional — Windows DHCP server integration)
# DHCP_ENABLED=false
# DHCP_SERVER=
# DHCP_USERNAME=
# DHCP_PASSWORD=
# DHCP_USE_SSL=true
# DHCP_SYNC_INTERVAL=3600

# Frontend (override in production — leave empty to use relative URLs)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
