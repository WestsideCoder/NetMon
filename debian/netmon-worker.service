[Unit]
Description=NetMon Celery Worker
After=network.target postgresql.service redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=netmon
Group=netmon
WorkingDirectory=/usr/share/netmon/backend
EnvironmentFile=/etc/netmon/config.env
ExecStart=/usr/share/netmon/venv/bin/celery -A app.tasks worker --loglevel=info --concurrency=4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
